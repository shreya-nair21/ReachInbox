datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String?
  avatar           String?
  googleId         String            @unique
  slackIntegration SlackIntegration?
  emails           EmailSchedule[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model SlackIntegration {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId             String?
  teamName           String?
  accessToken        String?  @db.Text
  incomingWebhookUrl String?  @db.Text
  channel            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  RESCHEDULED
}

model EmailSchedule {
  id                       String      @id @default(uuid())
  userId                   String
  user                     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderEmail              String
  recipientEmail           String
  subject                  String
  body                     String      @db.Text
  scheduledAt              DateTime
  sentAt                   DateTime?
  status                   EmailStatus @default(SCHEDULED)
  errorMessage             String?     @db.Text
  etherealPreviewUrl       String?     @db.Text
  rateLimitRescheduleCount Int         @default(0)
  batchId                  String?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
  @@index([senderEmail])
}
